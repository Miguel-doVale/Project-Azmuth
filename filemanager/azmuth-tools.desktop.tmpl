[Desktop Entry]
Type=Service
MimeType=inode/directory;
Actions=decorate;terminal;editor;
X-KDE-Submenu=Azmuth · ferramentas
X-KDE-Priority=TopLevel
X-KDE-Protocols=file
Icon=${icon}

[Desktop Action terminal]
Name=Abrir no terminal do Omnitrix
Icon=utilities-terminal
Exec=${az} files --terminal %f

[Desktop Action editor]
Name=Abrir projeto no VS Code
Icon=visual-studio-code
Exec=${az} files --code %f

[Desktop Action decorate]
Name=Personalizar pasta · cores e runas
Icon=${icon}
Exec=${az} files --decorate %f
