// Project Azmuth — fastfetch (instalado via symlink em ~/.config/fastfetch/config.jsonc)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/omnitrix.txt",
        "color": { "1": "cyan", "2": "90" },
        "padding": { "top": 1, "left": 2, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "cyan", "title": "cyan" },
        "key": { "width": 9 }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{user-name}@{host-name}" },
        { "type": "command", "key": "DNA", "text": "~/.local/bin/azmuth current --name" },
        { "type": "os", "key": "OS" },
        { "type": "kernel", "key": "Kernel" },
        { "type": "wm", "key": "WM" },
        { "type": "uptime", "key": "Uptime" },
        { "type": "packages", "key": "Pacotes" },
        { "type": "cpu", "key": "CPU", "format": "{name}" },
        { "type": "memory", "key": "RAM" },
        { "type": "disk", "key": "Disco", "folders": "/" },
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
