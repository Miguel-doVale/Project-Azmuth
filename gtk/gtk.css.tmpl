/* GERADO pelo Project Azmuth (DNA: ${dna}) — não edite aqui: edite gtk/gtk.css.tmpl no projeto.
   Tema GTK 3/4 da rice: diálogos de arquivo (portal), janelas GTK e menus seguem a paleta do DNA.
   Base escura do Adwaita + cores do Omnitrix por cima. */

@define-color accent_color ${primary};
@define-color accent_bg_color ${primary};
@define-color accent_fg_color ${background};
@define-color window_bg_color ${background};
@define-color window_fg_color ${foreground};
@define-color view_bg_color ${background};
@define-color view_fg_color ${foreground};
@define-color headerbar_bg_color ${surface};
@define-color headerbar_fg_color ${foreground};
@define-color sidebar_bg_color ${surface};
@define-color popover_bg_color ${raised};
@define-color dialog_bg_color ${background};
@define-color card_bg_color ${surface};
@define-color theme_bg_color ${background};
@define-color theme_fg_color ${foreground};
@define-color theme_base_color ${background};
@define-color theme_text_color ${foreground};
@define-color theme_selected_bg_color ${primary};
@define-color theme_selected_fg_color ${background};
@define-color borders ${border_inactive};

/* ── janela ── */
window, .background, dialog {
    background-color: ${background};
    color: ${foreground};
}
decoration { box-shadow: 0 0 0 1px ${frame}, 0 12px 40px rgba(0, 0, 0, 0.55); border-radius: 10px; }

headerbar, .titlebar {
    background: ${surface};
    color: ${foreground};
    border: none;
    border-bottom: 1px solid ${frame};
    box-shadow: none;
    min-height: 46px;
}
headerbar .title, .titlebar .title {
    font-family: "Orbitron";
    font-weight: 700;
    font-size: 10pt;
    letter-spacing: 2px;
    color: ${primary};
}

/* ── botões ── */
button {
    background: ${raised};
    color: ${foreground};
    border: 1px solid ${border_inactive};
    border-radius: 7px;
    box-shadow: none;
    text-shadow: none;
    -gtk-icon-shadow: none;
    padding: 5px 12px;
}
button:hover { background: ${hover}; border-color: ${frame}; }
button:active, button:checked { background: ${selection}; border-color: ${primary}; color: ${foreground}; }
button:disabled { opacity: 0.45; }
button.suggested-action, button.default {
    background: ${primary};
    color: ${background};
    border-color: ${primary};
    font-weight: 700;
}
button.suggested-action:hover { background: ${primary_light}; }
button.destructive-action { background: #ff5a5a; color: ${background}; border-color: #ff5a5a; }
button.flat, headerbar button.titlebutton { background: transparent; border-color: transparent; }
button.flat:hover { background: ${hover}; }

/* ── campos ── */
entry, spinbutton, textview text {
    background: ${input};
    color: ${foreground};
    border: 1px solid ${border_inactive};
    border-radius: 7px;
    box-shadow: none;
    caret-color: ${primary};
}
entry:focus { border-color: ${primary}; box-shadow: 0 0 0 1px ${primary}; }
entry selection, textview text selection, label selection { background: ${selection}; color: ${foreground}; }
entry image { color: ${muted}; }

/* ── listas e tabelas (lista de arquivos) ── */
treeview.view, .view, iconview, list, listview, columnview {
    background-color: ${background};
    color: ${foreground};
}
treeview.view:hover, row:hover { background-color: ${hover}; }
/* sem traço lateral aqui: no GTK3 a seleção da tabela é desenhada célula por célula */
treeview.view:selected, .view:selected, row:selected, iconview:selected {
    background-color: ${selection};
    color: ${foreground};
}
treeview.view:selected:focus { color: ${primary}; }
treeview.view header button, columnview > header > button {
    background: ${surface};
    color: ${muted};
    border: none;
    border-bottom: 1px solid ${frame};
    border-radius: 0;
    font-family: "Orbitron";
    font-size: 8pt;
    letter-spacing: 1px;
    padding: 7px 10px;
}
treeview.view header button:hover { color: ${primary}; background: ${surface}; }
treeview.view.separator { color: ${border_inactive}; }

/* ── barra lateral de locais ── */
placessidebar, .sidebar, stacksidebar {
    background-color: ${surface};
    border-right: 1px solid ${frame};
}
placessidebar row, .sidebar row {
    border-radius: 7px;
    margin: 1px 6px;
    padding: 2px 4px;
    color: ${foreground};
}
placessidebar row:hover { background: ${hover}; }
placessidebar row:selected, .sidebar row:selected {
    background: ${selection};
    color: ${primary};
    box-shadow: inset 3px 0 0 ${primary};
}
placessidebar row:selected image { color: ${primary}; }
placessidebar image { color: ${muted}; }
placessidebar separator { background: ${frame}; margin: 6px 10px; }

/* ── caminho (path bar) ── */
.path-bar button, filechooser .path-bar button {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    color: ${muted};
    padding: 4px 10px;
}
.path-bar button:hover { background: ${hover}; color: ${foreground}; }
.path-bar button:checked, .path-bar button.text-button:checked {
    background: ${selection};
    color: ${primary};
    border-color: ${frame};
    font-weight: 700;
}

/* ── seletor de arquivos ── */
filechooser { background: ${background}; }
filechooser .dialog-action-box { border-top: 1px solid ${frame}; background: ${surface}; }
filechooser #pathbarbox { background: ${surface}; border-bottom: 1px solid ${frame}; padding: 6px 8px; }
filechooser paned > separator { background: ${frame}; min-width: 1px; }
filechooser .search-bar, searchbar > revealer > box { background: ${surface}; border-bottom: 1px solid ${frame}; }
filechooser placesview .server-list-button, placesview { background: ${background}; }

/* ── menus, popovers, dicas ── */
menu, .menu, .context-menu, popover, popover.background > contents, popover > arrow {
    background: ${raised};
    color: ${foreground};
    border: 1px solid ${frame};
    border-radius: 9px;
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.5);
}
menuitem:hover, modelbutton:hover, popover modelbutton:hover { background: ${selection}; color: ${foreground}; }
tooltip, tooltip.background { background: ${raised}; color: ${foreground}; border: 1px solid ${frame}; border-radius: 6px; }

/* ── controles ── */
checkbutton check, radiobutton radio, check, radio {
    background: ${input};
    border: 1px solid ${border_inactive};
    color: ${background};
}
check:checked, radio:checked { background: ${primary}; border-color: ${primary}; }
switch { background: ${raised}; border: 1px solid ${border_inactive}; border-radius: 13px; }
switch:checked { background: ${primary}; border-color: ${primary}; }
switch slider { background: ${foreground}; border-radius: 10px; border: none; }
scale trough, progressbar trough { background: ${raised}; border: none; }
scale highlight, progressbar progress { background: ${primary}; border: none; }
scale slider { background: ${background}; border: 2px solid ${primary}; }

scrollbar { background: transparent; border: none; }
scrollbar slider { background: ${border_inactive}; border-radius: 6px; min-width: 6px; min-height: 6px; border: 2px solid transparent; }
scrollbar slider:hover { background: ${muted}; }

notebook > header { background: ${surface}; border-color: ${frame}; }
notebook > header tab { color: ${muted}; }
notebook > header tab:checked { color: ${primary}; box-shadow: inset 0 -2px ${primary}; }

*:selected { background-color: ${selection}; color: ${foreground}; }
