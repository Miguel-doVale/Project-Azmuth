<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256">
<!-- Project Azmuth — pasta "tech discreto". ${color} = cor da pasta; ${accent} = friso (cor do DNA);
     ${markers} = runas e textos. Sem filtros: o Qt SVG (Dolphin) não suporta blur. -->
<defs>
  <linearGradient id="front" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="${color}"/>
    <stop offset="1" stop-color="${deep}"/>
  </linearGradient>
</defs>
<!-- aba de trás -->
<path d="M22 66a10 10 0 0 1 10-10h58a10 10 0 0 1 7 3l13 13h114a10 10 0 0 1 10 10v28H22Z" fill="${back}"/>
<!-- frente -->
<rect x="18" y="88" width="220" height="140" rx="12" fill="url(#front)"/>
<!-- friso luminoso: o único detalhe Omnitrix -->
<path d="M36 96h126l8 8h50" fill="none" stroke="${accent}" stroke-opacity=".35" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M36 96h126l8 8h50" fill="none" stroke="${accent_light}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
${markers}
</svg>
